# Secret - 敏感配置模板
# 使用方法：
# 1. 复制此文件为 secret.yaml: cp secret.yaml.example secret.yaml
# 2. 填入实际的凭证信息
# 3. 应用到集群: kubectl apply -f secret.yaml
# 注意：secret.yaml 已在 .gitignore 中，不会被提交到代码库
apiVersion: v1
kind: Secret
metadata:
  name: crm-python-secret
  namespace: default
  labels:
    app: crm-python
    environment: development
type: Opaque
stringData:
  # 数据库配置
  DB_USER: "bantu_user"
  DB_PASSWORD: "your_db_password_here"

  # JWT 密钥（生产环境必须更改）
  JWT_SECRET: "your_jwt_secret_here"

  # Redis 配置
  REDIS_PASSWORD: "your_redis_password_here"

  # MongoDB 配置
  MONGO_USERNAME: "bantu_mongo_user"
  MONGO_PASSWORD: "your_mongo_password_here"

  # MinIO 配置
  MINIO_ACCESS_KEY: "your_minio_access_key_here"
  MINIO_SECRET_KEY: "your_minio_secret_key_here"

  # Alibaba Cloud OSS 配置
  OSS_ACCESS_KEY_ID: "your_oss_access_key_id_here"
  OSS_ACCESS_KEY_SECRET: "your_oss_access_key_secret_here"

  # 天眼查 API 配置（敏感信息）
  TIANYANCHA_API_KEY: "your_tianyancha_api_key_here"

---
# 使用说明：
# 1. 生产环境创建 Secret：
#    kubectl create secret generic crm-python-secret \
#      --from-literal=DB_USER=bantu_user \
#      --from-literal=DB_PASSWORD=your_password \
#      --from-literal=JWT_SECRET=your_jwt_secret \
#      --from-literal=OSS_ACCESS_KEY_ID=your_oss_key \
#      --from-literal=OSS_ACCESS_KEY_SECRET=your_oss_secret \
#      --from-literal=TIANYANCHA_API_KEY=your_tianyancha_api_key
#
# 2. 或者使用 base64 编码：
#    echo -n 'your_password' | base64
#    然后在 data 字段中使用 base64 编码的值
#
# 3. 获取凭证：
#    - 阿里云 OSS: https://ram.console.aliyun.com/manage/ak
#    - 天眼查 API: https://open.tianyancha.com/



