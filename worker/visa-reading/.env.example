# Visa Reading Worker Environment Configuration
#
# 注意：本项目使用根目录的 .env 文件（../../.env）
# 不需要在此目录创建单独的 .env 文件
#
# 请确保根目录 .env 文件包含以下配置：

# Composio API Configuration
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_DANGEROUSLY_SKIP_VERSION_CHECK=true

# OpenAI API Configuration (DeepSeek)
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com

# Database Configuration (已在根目录 .env 中配置)
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=bantu_crm
# DB_USER=bantu_user
# DB_PASSWORD=your_database_password_here
