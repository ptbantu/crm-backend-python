# BANTU CRM Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to version control

# ============================================
# Database Configuration (MySQL)
# ============================================
# MySQL database connection settings
DB_HOST=mysql
DB_PORT=3306
DB_NAME=bantu_crm
DB_USER=bantu_user
DB_PASSWORD=

# ============================================
# Redis Configuration
# ============================================
# Redis cache and session storage
REDIS_HOST=redis.default.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# MongoDB Configuration
# ============================================
# MongoDB for document storage and logs
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=bantu_crm
MONGO_USERNAME=bantu_mongo_user
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=bantu_crm

# ============================================
# MinIO Configuration
# ============================================
# MinIO object storage (S3-compatible)
MINIO_ENDPOINT=minio.default.svc.cluster.local
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=bantu-crm
MINIO_SECURE=false

# ============================================
# Alibaba Cloud OSS Configuration
# ============================================
# Alibaba Cloud Object Storage Service
# Get credentials from: https://ram.console.aliyun.com/manage/ak
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=bantuqifu-dev
OSS_ENDPOINT=oss-ap-southeast-5.aliyuncs.com

# ============================================
# JWT Configuration
# ============================================
# JSON Web Token settings for authentication
# Generate a secure random string for JWT_SECRET (e.g., openssl rand -hex 32)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400000

# ============================================
# Tianyancha API Configuration
# ============================================
# Tianyancha enterprise information query API
# Get API key from: https://open.tianyancha.com/
TIANYANCHA_API_KEY=
TIANYANCHA_API_URL=https://api.tianyancha.com
TIANYANCHA_TIMEOUT=30

# ============================================
# Email Configuration (SMTP)
# ============================================
# SMTP server settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BANTU CRM

# ============================================
# WeChaty Configuration
# ============================================
# WeChat bot integration
WECHATY_NAME=bantu-crm-bot
WECHATY_TOKEN=
WECHATY_ENDPOINT=

# ============================================
# WhatsApp Configuration
# ============================================
# WhatsApp Business API integration
# Get credentials from: https://developers.facebook.com/
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ============================================
# Chroma Configuration
# ============================================
# Chroma vector database for embeddings
CHROMA_HOST=chroma.default.svc.cluster.local
CHROMA_PORT=8000

# ============================================
# CORS Configuration
# ============================================
# Cross-Origin Resource Sharing settings
# Development: CORS_ALLOWED_ORIGINS=["*"]
# Production: CORS_ALLOWED_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]
CORS_ALLOWED_ORIGINS=["*"]

# ============================================
# Application Configuration
# ============================================
APP_NAME=bantu-crm
APP_VERSION=1.0.0
DEBUG=false

# ============================================
# Composio API Configuration (Visa Reading Worker)
# ============================================
# Composio platform for Gmail integration
# Get API key from: https://app.composio.dev/
COMPOSIO_API_KEY=
COMPOSIO_DANGEROUSLY_SKIP_VERSION_CHECK=true
COMPOSIO_ENTITY_ID=

# ============================================
# OpenAI API Configuration (DeepSeek for Visa Reading)
# ============================================
# DeepSeek AI for document parsing
# Get API key from: https://platform.deepseek.com/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# ============================================
# Visa Reading Worker Configuration
# ============================================
# Sender email to filter visa notifications
VISA_SENDER_EMAIL=ws19930801@163.com
# Days threshold for urgent visa expiry
VISA_URGENCY_THRESHOLD_DAYS=7
# Maximum emails to process per run
VISA_MAX_EMAILS_PER_RUN=50
# Check interval in seconds (for continuous mode)
VISA_CHECK_INTERVAL_SECONDS=120

# ============================================
# Scheduler Configuration
# ============================================
VISA_NOTIFICATION_ENABLED=true
VISA_NOTIFICATION_CRON_HOUR=9
VISA_NOTIFICATION_CRON_MINUTE=0
VISA_NOTIFICATION_TIMEZONE=Asia/Jakarta

# ============================================
# WeCom (Enterprise WeChat) Configuration
# ============================================
# Get webhook URL from: https://work.weixin.qq.com/
# 企业微信群机器人 Webhook 地址
# 获取方式：企业微信群 -> 群设置 -> 群机器人 -> 添加机器人 -> 复制 Webhook 地址
WECOM_WEBHOOK_URL=
WECOM_ENABLED=false
